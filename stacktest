setcpm(126/16) // 126 BPM, 4 bars per cycle

stack(
    // 1. KICK - four on the floor; ducks orbits 2 & 3 (the "pump")
    s("bd*16")
      .duckorbit("2:3")
      .duckattack(0.2)
      .duckdepth("0.8:0.5")

    // 2. CLAP - beats 2 & 4
      // ,s("~ cp ~ cp!4").gain(0.8)

